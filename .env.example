# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# baepass_Key: Toggle to enable (1) or disable (0) password protection for the site.
# 1 = password required before entering site
# 0 = password disabled (default)
baepass_Key="0"

# Site access password(s). Any environment variable starting with "bae_Key" is recognized as a valid access password.
# Multiple passwords can be provided (e.g. for different family members or roles).
bae_Key="baelove2026"
bae_Key_Admin="baeloveAdmin2026"
